{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reminder-agent:dataset:1.0.0",
  "title": "EvaluationDataset",
  "description": "evals/dataset.json (spec FR-032..FR-034). Category minimums, tag sub-coverage, requirement-ID existence, expected_due_at >= now and context validity are checked in code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_version", "cases"],
  "properties": {
    "dataset_version": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "input", "now", "timezone", "existing_reminders",
                     "expected_intent", "expected_due_at", "due_at_tolerance_minutes",
                     "expected_task_keywords", "requirements"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"enum": ["normal", "boundary", "ambiguous", "missing_task", "missing_time",
                                "malformed", "reschedule_snooze", "guardrail"]},
          "tags": {"type": "array", "items": {"type": "string"}},
          "input": {
            "oneOf": [
              {"type": "string"},
              {"type": "object", "additionalProperties": false, "required": ["repeat", "times"],
               "properties": {"repeat": {"type": "string", "minLength": 1},
                              "times": {"type": "integer", "minimum": 1}}}
            ]
          },
          "now": {"type": "string"},
          "timezone": {"type": "string"},
          "existing_reminders": {
            "type": "array",
            "items": {"type": "object", "additionalProperties": false, "required": ["id", "task", "due_at"],
                      "properties": {"id": {"type": "string"}, "task": {"type": "string"}, "due_at": {"type": "string"}}}
          },
          "expected_intent": {"enum": ["create", "reschedule", "snooze", "clarify", "refuse"]},
          "expected_due_at": {"type": ["string", "null"]},
          "due_at_tolerance_minutes": {"const": 1},
          "expected_task_keywords": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^FR-\\d{3}$"}}
        }
      }
    }
  }
}
